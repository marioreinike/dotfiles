#!/bin/bash
# Claude Code state hook — tracks agent state for the dashboard.
# Writes state to /tmp/claude-agent-states/<session_id>.
# Fires on: UserPromptSubmit, PostToolUse, Stop, Notification, SessionEnd.

STATE_DIR="/tmp/claude-agent-states"
mkdir -p "$STATE_DIR"

input=$(head -c 4096)

# Simple JSON string field extraction (top-level only)
json_str() {
  printf '%s' "$input" | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/.*:[[:space:]]*"//;s/"$//'
}

session_id=$(json_str session_id)
[ -z "$session_id" ] && exit 0

event=$(json_str hook_event_name)

case "$event" in
  UserPromptSubmit|PostToolUse)
    state="thinking"
    # Retract the pending agent-notify notification once you answered:
    #   - any notification: on your next prompt (UserPromptSubmit).
    #   - "waiting <tool>": also on the PostToolUse of that same tool (you
    #     approved it). A "done" one is never retracted by PostToolUse, since
    #     background tasks and subagents keep firing it after Stop.
    # Synchronous on purpose, so it can't race a new notification that reuses
    # the same group right after.
    pending="/tmp/agent-notify/$session_id"
    if [ -f "$pending" ]; then
      read -r kind tool < "$pending"
      if [ "$event" = "UserPromptSubmit" ] \
        || { [ "$kind" = "waiting" ] && [ -n "$tool" ] && [ "$(json_str tool_name)" = "$tool" ]; }; then
        rm -f "$pending"
        /opt/homebrew/bin/terminal-notifier -remove "agent-$session_id" >/dev/null 2>&1
      fi
    fi
    ;;
  Stop)
    state="idle"
    ;;
  Notification)
    ntype=$(json_str notification_type)
    case "$ntype" in
      permission_prompt) state="waiting" ;;
      idle_prompt) state="idle" ;;
      *) exit 0 ;;
    esac
    ;;
  SessionEnd)
    rm -f "$STATE_DIR/$session_id"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

# Walk up parent processes to find the claude process's TTY.
# Hooks are spawned without a controlling terminal, so $$ reports "??".
agent_tty=""
pid=$PPID
for _ in 1 2 3 4 5 6; do
  [ -z "$pid" ] || [ "$pid" = "1" ] && break
  t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
  if [ -n "$t" ] && [ "$t" != "?" ] && [ "$t" != "??" ]; then
    agent_tty="$t"; break
  fi
  pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
done
[ -z "$agent_tty" ] && exit 0

printf '%s\n%s\n' "$state" "$agent_tty" > "$STATE_DIR/$session_id"
