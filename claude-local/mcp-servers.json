{
  "clickup": {
    "type": "http",
    "url": "https://mcp.clickup.com/mcp"
  },
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest",
      "--browser",
      "chrome",
      "--user-data-dir",
      "/Users/mario/.cache/playwright-mcp-profile",
      "--caps",
      "pdf,vision"
    ],
    "env": {}
  },
  "datadog-mcp": {
    "type": "http",
    "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
    "headers": {
      "DD_API_KEY": "# REDACTED - set this manually",
      "DD_APPLICATION_KEY": "# REDACTED - set this manually"
    }
  },
  "postgres-vambe-dev": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "mcp-postgres-server"
    ],
    "env": {
      "PG_HOST": "dev-db.vambe.ai",
      "PG_PORT": "5432",
      "PG_USER": "postgres",
      "PG_PASSWORD": "# REDACTED - set this manually",
      "PG_DATABASE": "railway"
    }
  },
  "postgres-vambe-prod": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "mcp-postgres-server"
    ],
    "env": {
      "PG_HOST": "vambeai-prod-read-replica-1.c70gyemio0h8.us-west-2.rds.amazonaws.com",
      "PG_PORT": "5432",
      "PG_USER": "postgres_read",
      "PG_PASSWORD": "# REDACTED - set this manually",
      "PG_DATABASE": "railway"
    }
  },
  "vambe-product-os": {
    "type": "http",
    "url": "https://product.vambe.org/api/mcp",
    "headers": {
      "Authorization": "# REDACTED - set this manually"
    }
  },
  "vambe-backoffice": {
    "type": "http",
    "url": "https://api.vambe.ai/frontend/api/public/backoffice-mcp",
    "headers": {
      "Authorization": "# REDACTED - set this manually"
    }
  }
}
